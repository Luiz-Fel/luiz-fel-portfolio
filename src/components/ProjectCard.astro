---
import { ExternalLink } from "@lucide/astro";
import GithubIcon from "@/assets/github.svg";
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";


interface Props {
  title: string;
  description: string;
  image: ImageMetadata;
  techStack: { name: string; IconComponent?: any; colorClass?: string }[];
  liveUrl?: string;
  githubUrl?: string;
  featured?: boolean;
}

const {
  title,
  description,
  image,
  techStack,
  liveUrl,
  githubUrl,
  featured = false,
} = Astro.props;

---

    <article
      class={`group relative bg-card border border-border-subtle rounded-lg overflow-hidden transition-all duration-500 hover:border-gray-darker ${
        featured ? "md:col-span-2" : ""
      }`}
    >
      <div class="relative aspect-video overflow-hidden bg-secondary">
        <Image
          src={image}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
        />
        <div class="absolute inset-0 bg-linear-to-t from-card via-transparent to-transparent opacity-60" />
      </div>

      <div class="p-6">
        <div class="flex items-start justify-between mb-3">
          <h3 class="text-lg font-semibold text-foreground group-hover:text-foreground/90 transition-colors">
            {title}
          </h3>
          <div class="flex items-center gap-2">
            {githubUrl && (
              <a
                href={githubUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 text-muted-foreground hover:text-foreground transition-colors"
                aria-label="View source code"
              >
                <GithubIcon class="w-4 h-4" />
              </a>
            )}
            {liveUrl && (
              <a
                href={liveUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="p-2 text-muted-foreground hover:text-foreground transition-colors"
                aria-label="View live site"
              >
                <ExternalLink class="w-4 h-4" />
              </a>
            )}
          </div>
        </div>

        <p class="text-sm font-light text-muted-foreground leading-relaxed mb-5">
          {description}
        </p>

        <div class="flex items-center gap-3 flex-wrap">
          {techStack.map((tech) => (
            <div
              class="group/tech flex items-center gap-1.5 px-2 py-1 rounded bg-secondary/50 transition-colors hover:bg-secondary"
              title={tech.name}
            >
              {tech.IconComponent && (
                <tech.IconComponent 
                  class={`w-4 h-4 ${tech.colorClass || 'text-muted-foreground'} tech-icon`}
                />
              )}
              <span class="text-xs font-light text-muted-foreground tech-text">
                {tech.name}
              </span>
            </div>
          ))}
        </div>
      </div>
    </article>
