---
interface Props {
  role: string;
  company: string;
  period: string;
  description: string;
  highlights: string[];
  isLast?: boolean;
}

const {
  role,
  company,
  period,
  description,
  highlights,
  isLast = false,
} = Astro.props;
---

<div class="relative pl-8 pb-12 group">
  <div
    class="absolute -left-4 -right-4 -top-2 -bottom-2 rounded-lg bg-muted/0 group-hover:bg-muted/30 transition-all duration-300 -z-10"
  >
  </div>

  {
    !isLast && (
      <div class="absolute left-[2.5px] top-8 bottom-0 w-px border-l-2 border-dashed border-border-subtle group-hover:border-muted-foreground transition-colors" />
    )
  }

  <div
    class="absolute left-0 top-2 w-1.75 h-1.75 rounded-full border-2 border-muted-foreground bg-background group-hover:border-foreground group-hover:bg-foreground group-hover:scale-125 transition-all duration-300"
  >
  </div>

  <div>
    <div class="mb-6">
      <h3 class="text-lg font-semibold text-foreground mb-1 group-hover:text-foreground transition-colors">
        {role}
      </h3>
      <div class="flex items-center gap-2 text-sm mb-3">
        <span class="font-medium text-muted-foreground">{company}</span>
        <span class="text-border-subtle">•</span>
        <span class="font-light text-muted-foreground">{period}</span>
      </div>
      <p class="text-sm text-muted-foreground leading-relaxed">
        {description}
      </p>
    </div>

    <div class="border-l-2 border-muted-foreground/40 pl-4 transition-all duration-300 hover:border-muted-foreground hover:pl-5">
      <span
        class="text-xs font-medium tracking-wider uppercase text-muted-foreground block mb-2"
      >
        Key Highlights
      </span>
      {highlights.map((highlight) => (
        <div class="flex items-start mb-2">
          <span class="text-foreground mr-2">-></span>
        <p class="text-sm font-light text-muted-foreground leading-relaxed mb-2">
          {highlight}
        </p>
        </div>
      ))}
    </div>
  </div>
</div>