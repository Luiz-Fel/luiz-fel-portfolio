---
export interface Props {
    siteName?: string;
}
const { siteName = 'Luiz Pereira Portfolio' } = Astro.props;
const currentYear = new Date().getFullYear();
---

    <footer class="py-8 bg-background border-t border-border-subtle">
      <div class="container mx-auto px-6">
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm font-light text-muted-foreground">
            © {currentYear} {siteName}.
          </p>
          <p class="text-xs font-light text-muted-foreground/60">
            Designed & Developed with Astro + TailwindCSS.
          </p>
        </div>
      </div>
    </footer>
