---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css'; 
import '../index.css';
---
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <title>Luiz Pereira | Portfólio</title>
    <link rel="icon" type="image/svg+xml" href="logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfólio de Luiz Pereira, desenvolvedor web." />
    <meta name="keywords" content="Luiz Pereira, portfólio, desenvolvedor web, projetos, experiência, contato" />
    <meta name="author" content="Luiz Pereira" />
  </head>
  <body class="min-h-screen bg-background flex flex-col">
    <Navigation /> 
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>