---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css'; 
import '../index.css';
import PageTransition from '@/components/PageTransition.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const htmlLang = lang === 'pt-br' ? 'pt-BR' : 'en';
---
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <title>{t('meta.title')}</title>
    <link rel="icon" type="image/svg+xml" href="logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={t('meta.description')} />
    <meta name="keywords" content="Portfolio, Luiz Pereira, web developer, projects, experience, contact" />
    <meta name="author" content="Luiz Pereira" />
  </head>
  <body class="min-h-screen bg-background flex flex-col">
    <Navigation lang={lang} /> 
    <main class="flex-1">
      <PageTransition>
        <slot />
      </PageTransition>
    </main>
    <Footer lang={lang} />
  </body>
</html>