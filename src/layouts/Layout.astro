---
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css'; 
import '../index.css';
import PageTransition from '@/components/PageTransition.astro';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Luiz Pereira | Portfolio</title>
    <link rel="icon" type="image/svg+xml" href="logo.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Portfolio of Luiz Pereira, web developer." />
    <meta name="keywords" content="Portfolio, Luiz Pereira, web developer, projects, experience, contact" />
    <meta name="author" content="Luiz Pereira" />
  </head>
  <body class="min-h-screen bg-background flex flex-col">
    <Navigation /> 
    <main class="flex-1">
      <PageTransition>
        <slot />
      </PageTransition>
    </main>
    <Footer />
  </body>
</html>