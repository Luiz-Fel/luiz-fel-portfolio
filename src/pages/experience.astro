---
import ExperienceItem from "@/components/ExperienceItem.astro";
import Layout from "@/layouts/Layout.astro";
import { useTranslations, getLocalizedPath } from '../i18n/ui';

const lang = 'en';
const t = useTranslations(lang);

const experiences = [

  {
    role: "Frontend Developer",
    company: "New Tendency (Nova Tendência)",
    period: "May 2023 — Present",
    description:
      "Working on high-traffic web applications, focusing on performance optimization, scalability, and sustainable frontend architecture within the React ecosystem.",
    highlights:
      ["Refactored media rendering logic, reducing processing time by over 60% (from ~600ms to under 200ms), significantly improving performance under high user volume.",]
  },
  {
    role: "Frontend Developer",
    company: "Softeam",
    period: "September 2021 — May 2023",
    description: "Maintained and evolved modern web applications, collaborating in multidisciplinary design and product teams.",
    highlights:[
      "Introduced TypeScript to enhance code predictability and utilized Tailwind CSS/Figma to standardize interfaces, resulting in better maintainability, type-safety, and significant reduction in feature delivery time.",]  
    },
];

---
<Layout>

    <section class="min-h-screen pt-24 pb-24 bg-background">
        <div class="container mx-auto px-6 max-w-5xl">
          <div class="mb-20">
            <h2 class="text-sm font-medium text-muted-foreground tracking-widest uppercase mb-3">
              {t('experience.section')}
            </h2>
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-foreground mb-4">
              {t('experience.title')}
            </h1>
            <p class="text-base text-muted-foreground max-w-2xl font-light leading-relaxed">
              {t('experience.subtitle')}
            </p>
          </div>

          <div class="max-w-3xl">
            {experiences.map((exp, index) => (
              <ExperienceItem
                {...exp}
                isLast={index === experiences.length - 1}
              />
            ))}
          </div>

          <div class="mt-20 pt-12 border-t border-border-subtle max-w-3xl">
            <p class="text-sm text-muted-foreground mb-4">
              {t('experience.cta')}
            </p>
            <div class="flex gap-4 flex-wrap">
              <a 
                href={getLocalizedPath('/projects', lang)} 
                class="inline-block border-2 border-muted-foreground px-6 py-2 text-sm uppercase tracking-wider font-medium text-muted-foreground hover:border-foreground hover:text-foreground transition-all duration-300"
              >
                {t('experience.viewProjects')}
              </a>
              <a 
                href={getLocalizedPath('/contact', lang)} 
                class="inline-block border-2 border-foreground px-6 py-2 text-sm uppercase tracking-wider font-bold hover:bg-foreground hover:text-background transition-all duration-300
                "
              >
                {t('experience.contact')}
              </a>
            </div>
          </div>
        </div>
      </section>

</Layout>